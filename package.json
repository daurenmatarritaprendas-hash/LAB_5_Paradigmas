{
  "dependencies": {
    "express": "^4.22.3",
    "mocha": "^12.0.3",
    "socket.io": "^4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:integration": "node ./node_modules/jest/bin/jest.js tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jest": "^30.5.2",
    "jsdom": "^29.1.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/integration/**/*.test.js"
    ]
  }
}
